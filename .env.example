# CrimeMap SA environment variables
#
# Copy to .env.local and fill in. Never commit .env.local.
#
# SUPABASE_SERVICE_ROLE_KEY must never be referenced from client components or from any file
# that is imported into the browser bundle. It is used only by the Python pipeline and by
# server-only code behind the protected admin route.

# --- Supabase -----------------------------------------------------------------
# Project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key. Safe to expose to the browser; all access is gated by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key. Server and pipeline only. Copy from the Supabase dashboard:
# Project Settings -> API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Map ----------------------------------------------------------------------
# Any MapLibre-compatible style URL. The default below is OpenFreeMap's Positron style,
# which needs no API key. Swap for MapTiler, Protomaps or a self-hosted style as needed.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# --- Analytics ----------------------------------------------------------------
# Set to "true" to mount Vercel Analytics. Left unset in local development.
NEXT_PUBLIC_VERCEL_ANALYTICS=

# --- Admin --------------------------------------------------------------------
# Shared secret required by the /admin route. Generate with: openssl rand -hex 32
# The admin route returns 404 when this is unset, so admin functionality is never
# reachable on an environment that has not been deliberately configured.
ADMIN_ACCESS_TOKEN=

# --- Site ---------------------------------------------------------------------
# Canonical origin, used for canonical URLs, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
